[Unit]
Description=Enable SEC touchscreen for Samsung S20 FE
After=android-service@hwcomposer.service
Requires=android-service@hwcomposer.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep 5 && echo 1 > /sys/class/sec/tsp/input/enabled'
RemainAfterExit=yes

[Install]
WantedBy=graphical.target